{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neon-escape",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "NeonRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NeonRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
